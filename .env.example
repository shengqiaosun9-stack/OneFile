# Backend runtime. Do NOT commit real secrets.
ONEPITCH_AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Local JSON store by default; set postgres + DATABASE_URL for Supabase production.
ONEPITCH_STORAGE_BACKEND=json
DATABASE_URL=

ONEFILE_ENV=development
ONEFILE_LOCAL_MODE=1
ONEFILE_OPS_ENABLED=1
